{
  "name": "kesher-ai",
  "private": true,
  "description": "Personal market intelligence that explains exactly why a market event matters to a specific investor.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w @kesher/api\" \"npm run dev -w @kesher/web\"",
    "build": "npm run build -w @kesher/web",
    "start": "npm run start -w @kesher/api",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "seed": "npm run seed -w @kesher/api",
    "record": "npm run record -w @kesher/api --",
    "record:models": "npm run record:models -w @kesher/api --",
    "record:bars": "npm run record:bars -w @kesher/api --",
    "recording:export": "npm run recording:export -w @kesher/api --",
    "verify:dev": "npm run verify:dev -w @kesher/api --",
    "research:dev": "npm run research:dev -w @kesher/api --",
    "graph:candidates": "npm run graph:candidates -w @kesher/api --",
    "graph:review": "npm run graph:review -w @kesher/api --",
    "graph:apply": "npm run graph:apply -w @kesher/api --",
    "graph:chunks": "npm run graph:chunks -w @kesher/api --",
    "graph:search": "npm run graph:search -w @kesher/api --",
    "embed:events": "npm run embed:events -w @kesher/api --",
    "record:xbrl": "npm run record:xbrl -w @kesher/api --",
    "smoke": "npm run smoke -w @kesher/api --"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
