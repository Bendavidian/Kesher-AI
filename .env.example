# Copy to .env and fill in. Never commit .env.
# Free tiers only (SPEC.md principle 9): any paid call is a bug.

MONGODB_URI=
JWT_SECRET=
# Signs MCP run tokens (HS256); at least 32 characters. The api does not start without it.
MCP_TOKEN_SECRET=

ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
FINNHUB_API_KEY=
SEC_USER_AGENT="Kesher AI you@example.com"

# The free Alpaca plan allows one live WebSocket: true on at most one machine, and only while proving the live path.
# The deployed instance is replay only (SPEC.md decision log, T18), so it stays false there too.
# With it true the api needs ALPACA_API_KEY_ID, ALPACA_API_SECRET_KEY and SEC_USER_AGENT, or it does not start.
LIVE_INGEST=false

# POST /demo/replay, the reset and replay of the pinned demo item behind the web's Replay control, for a signed in user.
# Unset, it is on outside production and off in production; the deployed instance sets true. Only true or false.
# DEMO_MODE=true

# The local embedding model (about 300 MB of memory): true (the default when unset) or false.
# false on the 512 MB free host: events stay unembedded, search_news uses words only, and research runs without search_filings.
# LOCAL_EMBEDDINGS=true

# Automatic research through the research gate after each scoring run: true (the default when unset) or false.
# Off, the gate records a skipped run (auto_research_off) for every card and calls no model; Investigate still works.
AUTO_RESEARCH=true

# LLM providers, free tiers through the Vercel AI SDK.
# Groq: extraction, the verifier and the injection screen; whole run fallback for research.
GROQ_API_KEY=
# Gemini Flash-Lite via Google AI Studio: the research agent; per call fallback for extraction and the verifier.
# Keep billing off on its Google Cloud project, or calls are charged.
GOOGLE_GENERATIVE_AI_API_KEY=

# V2: X has no free tier.
X_BEARER_TOKEN=
