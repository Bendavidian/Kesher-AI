# Copy to .env and fill in. Never commit .env.
# Free tiers only (SPEC.md principle 9): any paid call is a bug.

MONGODB_URI=
JWT_SECRET=
MCP_TOKEN_SECRET=

ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
FINNHUB_API_KEY=
SEC_USER_AGENT="Kesher AI you@example.com"

# The free Alpaca plan allows one live WebSocket: true on exactly one machine (after T18, only the deployed instance).
LIVE_INGEST=false

# LLM providers, free tiers through the Vercel AI SDK.
# Groq: primary for extraction, research and verification.
GROQ_API_KEY=
# Gemini Flash-Lite via Google AI Studio: backup for extraction.
# Keep billing off on its Google Cloud project, or calls are charged.
GOOGLE_GENERATIVE_AI_API_KEY=

# V2: X has no free tier.
X_BEARER_TOKEN=
